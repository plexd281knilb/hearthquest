{
  "name": "hearthquest",
  "version": "0.1.29",
  "private": true,
  "description": "Zero-Prep Family Tabletop 5e Engine with AI GM Co-Pilot & Physical Print-on-Demand Fulfillment",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:vtt": "npm --workspace=@hearthquest/quest-vtt run dev",
    "dev:admin": "npm --workspace=@hearthquest/quest-admin run dev",
    "dev:ai": "npm --workspace=@hearthquest/quest-ai-bridge run dev",
    "start": "npx tsx scripts/start-all.ts",
    "start:all": "npx tsx scripts/start-all.ts",
    "build": "npm --workspaces --if-present run build",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "test": "npm run verify",
    "verify": "npx tsx scripts/verify-all.ts",
    "verify:push": "npx tsx scripts/release-verify.ts --sync",
    "bump:patch": "npx tsx scripts/release-verify.ts --bump=patch",
    "bump:minor": "npx tsx scripts/release-verify.ts --bump=minor",
    "bump:major": "npx tsx scripts/release-verify.ts --bump=major"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
